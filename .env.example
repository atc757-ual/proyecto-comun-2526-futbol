# --- FUTBOL CLUB 2526 - CONFIGURACIÓN DE EJEMPLO ---
# Renombra este archivo a .env y reemplaza los valores con los reales
# Este archivo se utiliza en local y en producción via docker-compose

# ─── GOOGLE APIs ─────────────────────────────────────
# Obtener en: https://console.cloud.google.com
# Habilitar: Gemini API, Maps API (Geocoding)
GOOGLE_API_KEY=AIza_TU_CLAVE_AQUI
GOOGLE_API_KEY_JAVA=AIza_TU_CLAVE_AQUI

# Modelos de Gemini
GEMINI_MODEL=gemini-2.5-flash                    # Modelo principal
GEMINI_MODEL_JAVA=gemini-2.0-flash               # Modelo Java (backend-java)
GEMINI_MODEL_NODE=gemini-3.5-flash               # Modelo Node.js (backend-node)
GEMINI_API_VERSION_JAVA=v1
GEMINI_API_VERSION_NODE=v1beta

# ─── TheSportsDB API ─────────────────────────────────
# Obtener en: https://www.thesportsdb.com/api.php
# Valor por defecto: "3" (plan gratuito con limitaciones)
FOOTBALL_API_KEY=3
TSDB_BASE_URL=https://www.thesportsdb.com/api/v2/json

# ─── Seguridad ───────────────────────────────────────
# Generar con: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_muy_larga_y_aleatoria_aqui

# ─── Base de datos MongoDB (Backend Node) ──────────────
# En local (Docker): mongodb://mongo:27017/football
# En producción: mongodb+srv://usuario:password@cluster.mongodb.net/football
MONGO_URL=mongodb://mongo:27017/football

# ─── Base de datos PostgreSQL (Backend Java) ──────────
# Credenciales para PostgreSQL
DB_USER=root
DB_PASSWORD=root
DB_NAME=football_db

# ─── Firebase ────────────────────────────────────────
# Ruta al archivo de credenciales (JSON de Google Cloud)
# Estructura esperada:
#   {
#     "type": "service_account",
#     "project_id": "tu-proyecto",
#     "private_key": "...",
#     "client_email": "..."
#   }
FIREBASE_SERVICE_ACCOUNT=/app/firebase-credentials.json

# ─── Admin inicial (primera ejecución) ──────────────
# Email del usuario administrador inicial del sistema
INITIAL_ADMIN_EMAIL=admin@futbolclub.local

# ─── API Status (health checks) ───────────────────────
# Clave para acceder al endpoint /status
STATUS_API_KEY=clave_segura_para_status

# ─── Producción — Nginx + Let's Encrypt (perfil "vm") ───
# Solo se usan en despliegue en VM con docker compose --profile vm up
VIRTUAL_HOST=futbolclub.duckdns.org
VIRTUAL_PORT=80
LETSENCRYPT_HOST=futbolclub.duckdns.org
LETSENCRYPT_EMAIL=tu_email@dominio.com

# ─── NOTAS ──────────────────────────────────────────────
# 1. Las claves RSA (private_key.pem, public_key.pem) se generan automáticamente
#    en CI/CD. En local, ejecuta:
#      cd backend-node && openssl genrsa -out private_key.pem 2048
#      openssl rsa -in private_key.pem -pubout -out public_key.pem
#
# 2. El archivo firebase-credentials.json debe estar en la raíz del proyecto
#    (no en .gitignore, pero nunca commitear con datos reales)
#
# 3. Para desarrollo local, usa estos valores por defecto
#
# 4. En GitHub Actions CI, los secrets se definen en Settings > Secrets
#
