# ==========================================
# Dockerfile para el Bridge HTTP-CORBA
# ==========================================

# 1. Fase de construcción
FROM maven:3.9-eclipse-temurin-11 AS builder

WORKDIR /app

# El bridge necesita acceder a service-corba/src/main/idl para compilar (generar Stubs)
COPY service-corba/ ./service-corba/
COPY corba-bridge/ ./corba-bridge/

# Compilar y empaquetar el WAR
RUN cd corba-bridge && mvn clean package

# 2. Fase de ejecución (Runtime en Tomcat)
FROM tomcat:9.0-jre11-temurin

# Limpiar las aplicaciones por defecto de Tomcat
RUN rm -rf /usr/local/tomcat/webapps/*

# Copiar nuestro WAR compilado.
# Lo llamamos "corba-bridge.war" para que esté disponible en la ruta /corba-bridge
COPY --from=builder /app/corba-bridge/target/corba-bridge.war /usr/local/tomcat/webapps/corba-bridge.war

EXPOSE 8080

CMD ["catalina.sh", "run"]
