<?xml version="1.0" encoding="UTF-8"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

    <xsd:element name="noticia">
        <xsd:complexType>
            <xsd:sequence>
                <xsd:element name="id"       type="id_valid"/>
                <xsd:element name="date"     type="fecha_valid"/>
                <xsd:element name="title"    type="titulo_valid"/>
                <xsd:element name="author"   type="author_valid"/>
                <xsd:element name="summary"  type="summary_valid"/>
                <xsd:element name="content"  type="contenido_valid"/>
                <xsd:element name="imageUrl" type="url_valid"/>
                <xsd:element name="category" type="categoria_valid"/>
                <xsd:element name="isActive" type="xsd:boolean"/>
                <xsd:element name="isFeatured" type="xsd:boolean"/>
                <xsd:element name="tags"     type="tipoTags"/>
                <xsd:element name="createdBy" type="xsd:string"/>
                <xsd:element name="updatedBy" type="xsd:string"/>
                <xsd:element name="createdAt" type="xsd:string"/>
                <xsd:element name="updatedAt" type="xsd:string"/>
            </xsd:sequence>
        </xsd:complexType>
    </xsd:element>

    <!-- ID: no vacío, solo letras/números/guiones, 1-50 chars -->
    <xsd:simpleType name="id_valid">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="50"/>
            <xsd:pattern value="[a-zA-Z0-9\-_]+"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Fecha: formato DD/MM/YYYY -->
    <xsd:simpleType name="fecha_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="\d{2}/\d{2}/\d{4}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Título: entre 5 y 250 caracteres de cualquier tipo -->
    <xsd:simpleType name="titulo_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[\s\S]{5,250}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Author: entre 3 y 100 caracteres de cualquier tipo -->
    <xsd:simpleType name="author_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[\s\S]{3,100}"/>
        </xsd:restriction>
    </xsd:simpleType>
    
    <!-- Summary: entre 10 y 1000 caracteres de cualquier tipo -->
    <xsd:simpleType name="summary_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[\s\S]{10,1000}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Contenido: entre 20 y 10000 caracteres de cualquier tipo -->
    <xsd:simpleType name="contenido_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="[\s\S]{20,10000}"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- URL de imagen: debe empezar por http:// o https:// -->
    <xsd:simpleType name="url_valid">
        <xsd:restriction base="xsd:string">
            <xsd:pattern value="https?://\S+"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Categoría: solo valores válidos de fútbol -->
    <xsd:simpleType name="categoria_valid">
        <xsd:restriction base="xsd:string">
            <xsd:enumeration value="Fichajes"/>
            <xsd:enumeration value="Resultados"/>
            <xsd:enumeration value="Crónica"/>
            <xsd:enumeration value="Opinión"/>
            <xsd:enumeration value="Internacional"/>
            <xsd:enumeration value="Mundial 2026"/>
            <xsd:enumeration value="Táctica"/>
            <xsd:enumeration value="Actualidad"/>
            <xsd:enumeration value="Salud"/>
            <xsd:enumeration value="General"/>
        </xsd:restriction>
    </xsd:simpleType>

    <!-- Tags: entre 1 y 6 etiquetas -->
    <xsd:complexType name="tipoTags">
        <xsd:sequence>
            <xsd:element name="tag" type="tag_valid"
                         minOccurs="1" maxOccurs="6"/>
        </xsd:sequence>
    </xsd:complexType>

    <xsd:simpleType name="tag_valid">
        <xsd:restriction base="xsd:string">
            <xsd:minLength value="1"/>
            <xsd:maxLength value="15"/>
        </xsd:restriction>
    </xsd:simpleType>

</xsd:schema>
