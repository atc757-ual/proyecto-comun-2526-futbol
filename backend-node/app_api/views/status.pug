doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Fútbol Club - Status Hub
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet")
    script(type="module" src="https://unpkg.com/ionicons@7.4.0/dist/ionicons/ionicons.esm.js")
    script(nomodule src="https://unpkg.com/ionicons@7.4.0/dist/ionicons/ionicons.js")
    link(rel="stylesheet" href="/status.css")
  body
    .main-header
      .header-inner
        a.brand(href="/")
          .logo-ball-blue
            ion-icon(name="football")
          span.main-logo-text Fútbol Club

    .container
      header
        h1
          span.accent Status Hub
        p.subtitle Tecnologías y Recursos Web/Móvil (TRWM) · Salud operativa en tiempo real
        p.top-meta NODE BACKEND · EXPRESS + MONGODB
      
      .grid
        .card
          .card-title Estado del Servidor
          .info-row
            span.info-label Servicio Express
            span.info-value.badge.badge-success Activo
          .info-row
            span.info-label Puerto
            span.info-value #{port}
          .info-row
            span.info-label Entorno
            span.info-value.badge.badge-neutral #{env}
          .info-row
            span.info-label Uptime
            span.info-value #{uptime}
            
        .card
          .card-title Base de Datos MongoDB
          .info-row
            span.info-label Conexión Mongoose
            span.info-value.badge.badge-success #{dbState}
          .info-row
            span.info-label Host DB
            span.info-value #{dbHost}
          .info-row
            span.info-label Base de Datos
            span.info-value #{dbName}
            
        .card
          .card-title Métricas del Sistema
          .info-row
            span.info-label Jugadores Totales
            span.info-value.badge.badge-neutral #{totalPlayers}
          .info-row
            span.info-label Comentarios Totales
            span.info-value.badge.badge-neutral #{totalComments}
          .info-row
            span.info-label Usuarios Registrados
            span.info-value.badge.badge-neutral #{totalUsers}

      .card.cta-card
        h2(style="margin-bottom: 0.5rem; font-weight: 700; font-size: 1.35rem;") API Interactiva & Documentación
        p.subtitle Accede a la especificación Swagger / OpenAPI de los endpoints de Node.js
        a.btn(href="/api-docs" target="_blank") Ver Swagger UI

    footer
      .footer-inner
        p.footer-copy &copy; 2026 Fútbol Club by Alex Taquila
        .footer-socials
          a.social-link(href="https://www.linkedin.com/in/alextaquilacamasca" target="_blank" rel="noopener noreferrer")
            ion-icon(name="logo-linkedin")
            span LinkedIn
          a.social-link(href="https://github.com/atc757-ual" target="_blank" rel="noopener noreferrer")
            ion-icon(name="logo-github")
            span GitHub
