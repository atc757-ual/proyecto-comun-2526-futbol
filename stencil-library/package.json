{
  "name": "football-components",
  "version": "1.0.0",
  "description": "Librería de componentes Stencil para App de Fútbol",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
